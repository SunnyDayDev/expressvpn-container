# Detour — ExpressVPN sidecar: параметры уровня compose.
# Изменения здесь требуют пересоздания контейнера: docker compose up -d --build

# Порт SOCKS5-прокси на хосте (приложения ходят в socks5h://<BIND_ADDR>:<SOCKS_PORT>)
SOCKS_PORT=1080

# HTTP-порт веб-интерфейса и API агента
HTTP_PORT=48100

# Адрес привязки опубликованных портов.
# 127.0.0.1 — только этот хост (по умолчанию, безопасно).
# 0.0.0.0 или IP интерфейса — доступ из сети (NAS): обязательно задайте
# пароль UI и включите auth у SOCKS5 (Settings → Proxy).
BIND_ADDR=127.0.0.1

# Версия инсталлятора ExpressVPN Linux (universal .run, качается при сборке)
EXPRESSVPN_VERSION=14.2.0.13656
# SHA-256 инсталлятора (проверяется при сборке; см. README для обновления)
EXPRESSVPN_SHA256=9d770edc6548a17994fd15714c5030a8f5767671b76b2117a884f7d48d93f2cb

# Версия sing-box (uplink-движок)
SINGBOX_VERSION=1.13.19

# Версия агента (входит в тег образа)
AGENT_VERSION=0.1.0
