{
  "name": "detour",
  "owner": { "name": "SunnyDayDev", "url": "https://github.com/SunnyDayDev" },
  "description": "Плагины Detour — ExpressVPN sidecar-контейнера",
  "plugins": [
    {
      "name": "detour",
      "source": "./agents-plugin",
      "description": "Управление Detour через HTTP API агента: статус VPN, подключение и отключение, смена локации и протокола, настройки uplink, selfcheck, логи",
      "version": "0.2.1",
      "relevance": {
        "topic": "Detour (ExpressVPN sidecar-контейнер)",
        "signals": {
          "cwd": ["**/expressvpn*", "**/expressvpn*/**", "**/detour*"],
          "manifestDeps": [
            { "file": "docker-compose\\.ya?ml$", "pattern": "expressvpn" }
          ]
        }
      }
    }
  ]
}
